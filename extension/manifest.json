{
  "manifest_version": 3,
  "name": "DMG Mode",
  "version": "0.1.0",
  "description": "Restyles web pages with a retro 4-shade handheld LCD look.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "DMG Mode",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    { "resources": ["assets/fonts/*.woff2"], "matches": ["<all_urls>"] }
  ],
  "commands": {
    "toggle-dmg": {
      "suggested_key": { "default": "Alt+Shift+G", "mac": "Alt+Shift+G" },
      "description": "Toggle DMG Mode on the current tab"
    }
  }
}
